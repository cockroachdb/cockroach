subtest prepare-enum-update

statement ok
CREATE TYPE enum132105 AS ENUM ('hi');

statement ok
PREPARE p132105_hi AS SELECT $1::enum132105 = 'hi';

statement ok
ALTER TYPE enum132105 ADD VALUE 'hello';

query B
EXECUTE p132105_hi('hi');
----
true

statement ok
ALTER TYPE enum132105 RENAME VALUE 'hi' to 'aloha';

# Note, here our behavior differs from postgres -- pg would return true.
statement error invalid input value for enum enum132105: "hi"
EXECUTE p132105_hi('aloha');

# Test if we change the value back.
statement ok
ALTER TYPE enum132105 RENAME VALUE 'aloha' to 'hi';

statement error invalid input value for enum enum132105: "aloha"
EXECUTE p132105_hi('aloha');

query B
EXECUTE p132105_hi('hi');
----
true

statement ok
PREPARE p132105_hello AS SELECT $1::enum132105 = 'hello';

query B
EXECUTE p132105_hello('hello');
----
true

statement ok
ALTER TYPE enum132105 DROP VALUE 'hello';

statement error invalid input value for enum enum132105: "hello"
EXECUTE p132105_hello('hello');

# Test with implicit casting to udt.
statement ok
CREATE TABLE t132105 (enumcol enum132105);

statement ok
PREPARE p132105count AS SELECT count(*) FROM t132105 WHERE enumcol = 'hi';

statement ok
INSERT INTO t132105 VALUES ('hi'), ('hi')

query I
EXECUTE p132105count;
----
2

statement ok
ALTER TYPE enum132105 RENAME VALUE 'hi' to 'ciao';

# Note that here our behavior is different from pg -- pg would return 2.
statement error invalid input value for enum enum132105: "hi"
EXECUTE p132105count;

statement ok
CREATE TABLE t132105arr (enumarrcol enum132105[]);

statement ok
PREPARE p132105arrcount AS SELECT count(*) FROM t132105arr WHERE enumarrcol = ARRAY[('ciao'::enum132105)];

statement ok
ALTER TYPE enum132105 ADD VALUE 'privet';

statement ok
EXECUTE p132105arrcount;

statement ok
ALTER TYPE enum132105 RENAME VALUE 'ciao' TO 'konnichiwa';

# PG returns 0 here.
statement error invalid input value for enum enum132105: "ciao"
EXECUTE p132105arrcount;

statement ok
PREPARE p132105enum_range_null AS SELECT enum_range(NULL::enum132105);

statement ok
PREPARE p132105enum_range_datum AS SELECT enum_range('konnichiwa'::enum132105);

query T
EXECUTE p132105enum_range_null;
----
{konnichiwa,privet}

query T
EXECUTE p132105enum_range_datum;
----
{konnichiwa,privet}

# If we alter the name of an irrelevant value in the enum type,
# the EXECUTE will run successfully.
statement ok
ALTER TYPE enum132105 RENAME VALUE 'privet' TO '안녕하세요';

query T
EXECUTE p132105enum_range_null;
----
{konnichiwa,안녕하세요}

query T
EXECUTE p132105enum_range_datum;
----
{konnichiwa,안녕하세요}

# If we alter the name of the relevant value ('konnichiwa'), the
# EXECUTE for p132105enum_range_datum would fail.
statement ok
ALTER TYPE enum132105 RENAME VALUE 'konnichiwa' TO 'bonjour';

query T
EXECUTE p132105enum_range_null;
----
{bonjour,안녕하세요}

statement error invalid input value for enum enum132105: "konnichiwa"
EXECUTE p132105enum_range_datum;

subtest end

# Regression test for cockroachdb/cockroach#162487 with a string placeholder
# type hint. The type of the placeholder is overridden to the enum at PREPARE
# time.
subtest prepare-enum-placeholder-string-hint

statement ok
CREATE TYPE enum162487_hint AS ENUM ('a', 'b', 'c');
CREATE TABLE t162487_hint (k INT PRIMARY KEY, e enum162487_hint, INDEX (e));
CREATE TABLE t162487_other (k INT PRIMARY KEY, e enum162487_hint DEFAULT 'a');
INSERT INTO t162487_hint SELECT i, (ARRAY['a', 'b', 'c'])[1 + i % 3]::enum162487_hint FROM generate_series(1, 30) AS g(i);

statement ok
ANALYZE t162487_hint

statement ok
PREPARE p162487_varchar (VARCHAR) AS SELECT count(*) FROM t162487_hint WHERE e IN ($1);

query I
EXECUTE p162487_varchar('a');
----
10

# Changing the default of a column of another table bumps the version of the
# enum without changing t162487_hint, so the memo built for the prepared
# statement isn't stale on its own.
statement ok
ALTER TABLE t162487_other ALTER COLUMN e DROP DEFAULT

query I
EXECUTE p162487_varchar('a');
----
10

# The first execution after a version bump re-parses the prepared statement;
# the following ones must keep using the refreshed placeholder types, including
# after another bump.
query I
EXECUTE p162487_varchar('a');
----
10

statement ok
ALTER TABLE t162487_other ALTER COLUMN e SET DEFAULT 'b'

query I
EXECUTE p162487_varchar('b');
----
10

statement ok
ALTER TYPE enum162487_hint ADD VALUE 'd'

query I
EXECUTE p162487_varchar('d');
----
0

subtest end

# Regression tests for a user-defined type that is referenced only as the type
# of a placeholder. 'a' is type-checked as the enum at PREPARE time, so the
# prepared statement and the cached memo must be invalidated once the enum
# changes, including for a new session that hits the query cache.
subtest prepare-enum-placeholder-only

statement ok
CREATE TYPE enum_ph AS ENUM ('a');

statement ok
PREPARE p_ph_eq(enum_ph) AS SELECT $1 = 'a';

statement ok
PREPARE p_ph_in(enum_ph) AS SELECT $1 IN ('a');

statement ok
PREPARE p_ph_arr(enum_ph[]) AS SELECT $1 = '{a}';

statement ok
SET plan_cache_mode = force_generic_plan

statement ok
PREPARE p_ph_generic(enum_ph) AS SELECT $1 = 'a';

statement ok
RESET plan_cache_mode

query B
EXECUTE p_ph_eq('a');
----
true

query B
EXECUTE p_ph_arr(ARRAY['a']::enum_ph[]);
----
true

statement ok
SET plan_cache_mode = force_generic_plan

query B
EXECUTE p_ph_generic('a');
----
true

statement ok
RESET plan_cache_mode

statement ok
ALTER TYPE enum_ph ADD VALUE 'b'

query B
EXECUTE p_ph_eq('a');
----
true

query B
EXECUTE p_ph_eq('b');
----
false

query B
EXECUTE p_ph_in('a');
----
true

query B
EXECUTE p_ph_arr(ARRAY['a']::enum_ph[]);
----
true

statement ok
SET plan_cache_mode = force_generic_plan

query B
EXECUTE p_ph_generic('a');
----
true

statement ok
RESET plan_cache_mode

# A new session preparing the same statement hits the query cache.
user root nodeidx=0 newsession

statement ok
PREPARE p_ph_eq(enum_ph) AS SELECT $1 = 'a';

statement ok
ALTER TYPE enum_ph ADD VALUE 'c'

statement ok
PREPARE p_ph_eq2(enum_ph) AS SELECT $1 = 'a';

query B
EXECUTE p_ph_eq('a');
----
true

query B
EXECUTE p_ph_eq2('c');
----
false

user root

# Renaming a value of an enum that is referenced only as the type of a
# placeholder must also re-parse the prepared statement.
statement ok
CREATE TYPE enum_ph_rename AS ENUM ('a', 'b');

statement ok
PREPARE p_ph_rename(enum_ph_rename) AS SELECT $1 = 'a';

query B
EXECUTE p_ph_rename('b');
----
false

statement ok
ALTER TYPE enum_ph_rename RENAME VALUE 'a' TO 'z'

# Note that here our behavior is different from pg, which would return false.
statement error invalid input value for enum enum_ph_rename: "a"
EXECUTE p_ph_rename('b');

subtest end
