# Trigram LIKE. "foobar" yields 4 trigrams (foo, oob, oba, bar) which are
# AND-folded (allMustMatch); each intersect step charges its SpansToRead union,
# so 2+3+4 = 9.
opt expect-not=GenerateInvertedIndexScans set=(optimizer_span_limit=8)
