# Prepare + Install lifecycle:
# Flush creates manifest 159 (start=100, GetFileNums(60) => [100,160), manifest=159).
# After prepare (slow path), active is still 0 but pending engine exists.
# After install, active becomes 159, old engine goes to quiesced.
# After quiesced drains, enableUnreferencedFileDeletion is called on the new active.
# Also tests that snapshots before and after swap see the correct manifest.
init start-file-num=100
----

# Take snapshot before swap (on initial engine, manifest=0).
snapshot
----
snap-0 manifest-num=0

flush file=flush1.sst
----
GetFileNums(60) => [100, 160)
InstallNewManifest(current=0, new=MANIFEST-000159/159, files=[{000158.sst 158}])

# Active manifest is still 0 (flush doesn't update in-place).
state
----
rsEngineContainer{active=0, pending=(eng:false,prep:false), quiesced=0, refs=0, closing=false}

prepare manifest-num=159
----
ok

state
----
rsEngineContainer{active=0, pending=(eng:true,prep:false), quiesced=0, refs=0, closing=false}

install manifest-num=159
----
ok

state
----
rsEngineContainer{active=159, pending=(eng:false,prep:false), quiesced=1, refs=0, closing=false}

# Snapshot after swap should see new manifest.
snapshot
----
snap-1 manifest-num=159

# Close the pre-swap snapshot. It was on the old engine, which is now quiesced.
# The quiesced engine's closeInner blocks until this snapshot is closed.
close-snapshot name=snap-0
----
ok

wait-quiesced
----
ok

state
----
rsEngineContainer{active=159, pending=(eng:false,prep:false), quiesced=0, refs=0, closing=false}

op-log
----
EnableUnreferencedFileDeletion

close-snapshot name=snap-1
----
ok

close
----
ok

