# Test async-close: closeInner blocks until all snapshots are closed.
init start-file-num=100
----

open range=r1 manifest=0
----
opened r1: manifest=0

flush range=r1 file=data.sst
----
GetFileNums(60) => [100, 160)
InstallNewManifest(current=0, new=MANIFEST-000159/159, files=[{000158.sst 158}])
reopened r1: manifest=159

# Create a snapshot.
snapshot range=r1
----
snapshot r1-159

state range=r1
----
current-manifest: 159
manifest 159: refs=0 snaps=1 sstables=[000158.sst]

# Start async close - it will block because of the open snapshot.
async-close range=r1
----
async-close started: r1 (blocked waiting for snapshots)

# Close the snapshot.
close-snapshot name=r1-159
----
closed: r1-159

# Now wait-close should complete.
wait-close range=r1
----
async-close completed: r1
