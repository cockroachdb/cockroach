# Test basic flushes and snapshot.
init start-file-num=100
----

open range=r1 manifest=0
----
opened r1: manifest=0

state range=r1
----
current-manifest: 0
manifest 0: refs=0 snaps=0 sstables=[]

# Flush a file.
flush range=r1 file=flush1.sst
----
GetFileNums(60) => [100, 160)
InstallNewManifest(current=0, new=MANIFEST-000159/159, files=[{000158.sst 158}])
reopened r1: manifest=159

state range=r1
----
current-manifest: 159
manifest 159: refs=0 snaps=0 sstables=[000158.sst]

files dir=/r1
----
000158.sst:
  previous-manifest:0
MANIFEST-000159:
  manifest:159
  000158.sst

# Flush another file.
flush range=r1 file=flush2.sst
----
GetFileNums(60) => [160, 220)
InstallNewManifest(current=159, new=MANIFEST-000219/219, files=[{000218.sst 218}])
reopened r1: manifest=219

state range=r1
----
current-manifest: 219
manifest 219: refs=0 snaps=0 sstables=[000158.sst 000218.sst]

files dir=/r1
----
000158.sst:
  previous-manifest:0
000218.sst:
  previous-manifest:159
MANIFEST-000159:
  manifest:159
  000158.sst
MANIFEST-000219:
  manifest:219
  000158.sst
  000218.sst

# Take a snapshot.
snapshot range=r1
----
snapshot r1-219

state range=r1
----
current-manifest: 219
manifest 219: refs=0 snaps=1 sstables=[000158.sst 000218.sst]

# Close snapshot.
close-snapshot name=r1-219
----
closed: r1-219

state range=r1
----
current-manifest: 219
manifest 219: refs=0 snaps=0 sstables=[000158.sst 000218.sst]

close range=r1
----
closed: r1

