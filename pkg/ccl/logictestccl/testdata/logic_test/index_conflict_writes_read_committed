subtest storing_partial_index_corruption_173610

skip under duress

# The anomaly for a STORING column. The index stores c, which lives in its own
# family. TxnA (READ COMMITTED) moves the row into the index and reads c to build
# the entry, so c's family must be force-written too — not just the key and
# predicate families. TxnB is pinned to SERIALIZABLE (so it does not force-write,
# and independent of the config's default isolation) and modifies only c; without
# forcing c's family there would be no conflict.

statement ok
CREATE TABLE t173610_storing (
  id INT PRIMARY KEY,
  a  INT,
  b  INT,
  c  INT,
  FAMILY f_a (id, a),
  FAMILY f_b (b),
  FAMILY f_c (c),
  INDEX idx (a) STORING (c) WHERE b > 0
)

statement ok
INSERT INTO t173610_storing VALUES (1, 10, -5, 100)

statement ok
GRANT ALL ON TABLE t173610_storing TO testuser

user root

statement async txnStoring
BEGIN TRANSACTION ISOLATION LEVEL READ COMMITTED; SET LOCAL enable_implicit_select_for_update = off; UPDATE t173610_storing SET b = 5 WHERE id = 1 AND pg_sleep(2); COMMIT

user testuser

statement ok
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE; WITH s AS (SELECT pg_sleep(0.5)) UPDATE t173610_storing SET c = 200 WHERE id = 1; COMMIT

user root

awaitstatement txnStoring

query I
SELECT c FROM t173610_storing WHERE id = 1
----
200

# The partial index's stored c agrees with the primary index (200, not the stale
# 100 that TxnA read).
query II
SELECT a, c FROM t173610_storing@idx WHERE b > 0
----
10  200

subtest end

