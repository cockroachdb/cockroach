subtest partial_index_corruption_173610

skip under duress

# Regression test for #173610. When an UPDATE moves a row into a partial index's
# predicate, it must read the indexed columns to build the new index entry. If
# those columns live in a different column family than the predicate columns, the
# mutation scan reads a family that the UPDATE does not write. Under READ COMMITTED
# that read is guarded only by a best-effort unreplicated lock, which can be lost
# across a range split, lease transfer, or merge (simulated here by disabling
# implicit FOR UPDATE locking). A concurrent transaction can then change the
# indexed column without blocking, and because READ COMMITTED does not refresh
# reads, the UPDATE builds the index entry from the stale value, leaving the
# partial index inconsistent with the primary index.
#
# The two pg_sleeps below make the interleaving deterministic: TxnA reads claim at
# t=0 and holds until t=2s, while TxnB waits until t=0.5s to write claim (so TxnA's
# read comes first) and commits well before TxnA wakes. If a slow machine delays
# TxnA's read past TxnB's write, the race is not exercised and the test passes
# vacuously; it never false-fails.

statement ok
CREATE TABLE t173610 (
  id     INT PRIMARY KEY,
  status STRING NOT NULL,
  claim  STRING,
  FAMILY f_status (id, status),
  FAMILY f_claim  (claim),
  INDEX idx (claim, status) WHERE status = 'running'
)

statement ok
INSERT INTO t173610 VALUES (1, 'paused', NULL)

statement ok
GRANT ALL ON TABLE t173610 TO testuser

# TxnA reads claim (NULL) during its mutation scan, then sleeps without holding a
# lock on the row. It is written as a single compound statement so that it runs on
# a single connection: the logic test framework backs each user with a connection
# pool, and SET/BEGIN/COMMIT issued as separate statements are not guaranteed to
# land on the same connection.
user root

statement async txnA
BEGIN TRANSACTION ISOLATION LEVEL READ COMMITTED; SET LOCAL enable_implicit_select_for_update = off; UPDATE t173610 SET status = 'running' WHERE id = 1 AND pg_sleep(2); COMMIT

# TxnB waits until TxnA's read has happened, then writes claim in the other column
# family and commits during TxnA's remaining sleep. It is not blocked, because TxnA
# holds no lock.
user testuser

statement ok
WITH s AS (SELECT pg_sleep(0.5)) UPDATE t173610 SET claim = 's2' WHERE id = 1

user root

awaitstatement txnA

# The row now has claim = 's2'.
query TT
SELECT status, claim FROM t173610 WHERE id = 1
----
running  s2

# The partial index agrees with the primary index: TxnA's forced write to the
# claim column family conflicted with TxnB, so TxnA re-read the updated claim
# before building the index entry.
query IT
SELECT id, claim FROM t173610@idx WHERE status = 'running'
----
1  s2

subtest end

