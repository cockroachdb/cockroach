# LogicTest: local

# Restricted to one config: KV traces are config-specific, and every race subtest
# names its isolation level explicitly rather than relying on the config default,
# so the other configs would only cost CI time.
#
# The kvtrace subtests come first so that appending scenarios below cannot shift
# the table IDs their expected traces hard-code. The race subtests that follow
# rely on pg_sleep timing windows and each skip under duress, where those windows
# are unreliable.

subtest forced_write_kvtrace

statement ok
CREATE TABLE t173610_kv (
  id     INT PRIMARY KEY,
  status STRING NOT NULL,
  claim  STRING,
  FAMILY f_status (id, status),
  FAMILY f_claim  (claim),
  INDEX idx (claim, status) WHERE status = 'running'
)

statement ok
INSERT INTO t173610_kv VALUES (1, 'paused', NULL), (2, 'paused', NULL), (3, 'paused', NULL)

# Under serializable there is no forced write of the claim family.
query T kvtrace
UPDATE t173610_kv SET status = 'running' WHERE id = 1
----
Scan /Table/106/1/{1-2} lock Exclusive (Block, Unreplicated)
Put (locking) /Table/106/1/1/0 -> /TUPLE/2:2:Bytes/running
Put /Table/106/2/NULL/"running"/1/0 -> /BYTES/

# Under read committed the claim family is force-written (a Del tombstone, since
# claim is NULL) to materialize a write-write conflict.
statement ok
SET default_transaction_isolation = 'read committed'

query T kvtrace
UPDATE t173610_kv SET status = 'running' WHERE id = 2
----
Scan /Table/106/1/{2-3} lock Exclusive (Block, Unreplicated)
Put (locking) /Table/106/1/2/0 -> /TUPLE/2:2:Bytes/running
Del (locking) /Table/106/1/2/1/1
Put /Table/106/2/NULL/"running"/2/0 -> /BYTES/

statement ok
SET default_transaction_isolation = 'serializable'

subtest end

subtest delete_writes_all_families

# DELETE needs no forced write, for two independent reasons that both reduce to
# it writing every key the row could occupy rather than only the keys it changes:
#
#   - row.Deleter walks every family in the descriptor and issues a Del per
#     family key, with no check for whether that family holds a value.
#   - It encodes the secondary index entries with includeEmpty=true, the opposite
#     of the row updater, so it deletes index-entry families that hold nothing
#     too.
#
# Either one alone would serialize a concurrent writer. That is the asymmetry
# with UPDATE, which writes only the families holding updated columns and skips
# empty index-entry families, and so needs the conflict writes above.
#
# Both reasons are properties of row.Deleter, so neither covers the DeleteRange
# fast path, which bypasses it entirely (see canUseDeleteRange in
# pkg/sql/opt/exec/execbuilder/mutation.go). That path is reachable only on a
# table with no secondary indexes, so it cannot corrupt one, but it can corrupt
# the primary index in the analogous way (issue #175530): it writes no tombstone
# at an absent family's key, so a concurrent UPDATE materializing that family
# does not conflict. The forced sentinel write prevents it -- see the
# fastpath_delete_* subtests below.
#
# The trace below is the DELETE counterpart of
# full_index_null_family_corruption_173610: w is NULL and alone in its family, so
# it has neither a primary KV nor an index KV, yet both of its keys are still
# tombstoned.

statement ok
CREATE TABLE t173610_del_kv (
  x INT PRIMARY KEY,
  y INT,
  z INT,
  w INT,
  FAMILY f_x (x),
  FAMILY f_y (y),
  FAMILY f_z (z),
  FAMILY f_w (w),
  INDEX idx (y) STORING (z, w)
)

statement ok
INSERT INTO t173610_del_kv VALUES (1, 2, 3, NULL)

statement ok
SET default_transaction_isolation = 'read committed'

query T kvtrace
DELETE FROM t173610_del_kv WHERE x = 1
----
Scan /Table/107/1/1/{0-1/2} lock Exclusive (Block, Unreplicated)
Del /Table/107/2/2/1/0
Del /Table/107/2/2/1/2/1
Del /Table/107/2/2/1/3/1
Del (locking) /Table/107/1/1/0
Del (locking) /Table/107/1/1/1/1
Del (locking) /Table/107/1/1/2/1
Del (locking) /Table/107/1/1/3/1

statement ok
SET default_transaction_isolation = 'serializable'

subtest end

