subtest predicate_flip_partial_index_corruption_173610

skip under duress

# The reverse direction: the row starts IN the index, and the concurrent
# transaction flips the predicate column so the row must leave it. TxnA (READ
# COMMITTED) updates only the key column claim, which maintains the index and
# reads the predicate column status from an otherwise-unwritten family; that
# family is force-written. TxnB (pinned SERIALIZABLE, so it does not
# force-write) flips status to 'paused'. Without the forced write, TxnA would
# rebuild the index entry from the stale status = 'running' and leave a ghost
# row in the index.

statement ok
CREATE TABLE t173610_flip (
  id     INT PRIMARY KEY,
  status STRING NOT NULL,
  claim  STRING,
  FAMILY f_id    (id),
  FAMILY f_status (status),
  FAMILY f_claim (claim),
  INDEX idx (claim, status) WHERE status = 'running'
)

statement ok
INSERT INTO t173610_flip VALUES (1, 'running', 'x1')

statement ok
GRANT ALL ON TABLE t173610_flip TO testuser

user root

statement async txnFlip
BEGIN TRANSACTION ISOLATION LEVEL READ COMMITTED; SET LOCAL enable_implicit_select_for_update = off; UPDATE t173610_flip SET claim = 'x2' WHERE id = 1 AND pg_sleep(2); COMMIT

user testuser

statement ok
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE; WITH s AS (SELECT pg_sleep(0.5)) UPDATE t173610_flip SET status = 'paused' WHERE id = 1; COMMIT

user root

awaitstatement txnFlip

# The primary index has TxnB's status flip and TxnA's claim update.
query TT
SELECT status, claim FROM t173610_flip WHERE id = 1
----
paused  x2

# The row left the partial index: TxnA's forced write of the status family
# conflicted with TxnB, so TxnA re-read status = 'paused' and did not rebuild
# the index entry.
query IT
SELECT id, claim FROM t173610_flip@idx WHERE status = 'running'
----

subtest end

subtest full_index_null_family_corruption_173610

skip under duress

# The same anomaly without a partial index. Index entries are split per column
# family, and a family whose stored columns are all NULL produces no index KV at
# all, so the usual serialization — both transactions writing the old entry's key
# — does not happen. TxnA (READ COMMITTED) changes the key column y and reads
# w = NULL, so it writes no w-family index entry under either the old or the new
# key. TxnB (pinned SERIALIZABLE, so it does not force-write) sets w, writing the
# w-family entry under the old key. Without the forced write of w's family the
# two transactions share no KV and the index is left with an orphaned w entry
# under y = 2.

statement ok
CREATE TABLE t173610_full (
  x INT PRIMARY KEY,
  y INT,
  z INT,
  w INT,
  FAMILY f_x (x),
  FAMILY f_y (y),
  FAMILY f_z (z),
  FAMILY f_w (w),
  INDEX idx (y) STORING (z, w)
)

statement ok
INSERT INTO t173610_full VALUES (1, 2, 3, NULL)

statement ok
GRANT ALL ON TABLE t173610_full TO testuser

user root

statement async txnFull
BEGIN TRANSACTION ISOLATION LEVEL READ COMMITTED; SET LOCAL enable_implicit_select_for_update = off; UPDATE t173610_full SET y = 20 WHERE x = 1 AND pg_sleep(2); COMMIT

user testuser

statement ok
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE; WITH s AS (SELECT pg_sleep(0.5)) UPDATE t173610_full SET w = 7 WHERE x = 1; COMMIT

user root

awaitstatement txnFull

query IIII
SELECT x, y, z, w FROM t173610_full WHERE x = 1
----
1  20  3  7

# The index agrees with the primary index: TxnA's forced write of the w family
# conflicted with TxnB, so TxnA re-read w = 7 and moved the whole entry to y = 20.
query IIII
SELECT x, y, z, w FROM t173610_full@idx
----
1  20  3  7

subtest end
