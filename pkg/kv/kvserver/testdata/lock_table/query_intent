# Tests that a QueryIntent that reports a lock as missing marks any
# unreplicated locks held by the same transaction on the same key as
# ineligible for export, regardless of whether the QueryIntent evaluates on
# the read path or the write path.

# Read path: the QueryIntent is the only request in its batch.

new-txn txn=t1
----

get txn=t1 k=a lock=Exclusive dur=Unreplicated lock-non-existing
----
get: "\xfaa"=nil

query-intent txn=t1 k=a lock=Exclusive error-if-missing
----
error: intent missing

print-in-memory-lock-table
----
num=1
 lock: "\xfaa"
  holder: txn: t1 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export

# Write path: the QueryIntent shares a batch with a Put, as happens when the
# txn pipeliner prepends QueryIntents to a batch that contains writes.

new-txn txn=t2
----

get txn=t2 k=b lock=Exclusive dur=Unreplicated lock-non-existing
----
get: "\xfab"=nil

query-intent txn=t2 k=b lock=Exclusive error-if-missing batched-with-put=c
----
error: intent missing

print-in-memory-lock-table
----
num=2
 lock: "\xfaa"
  holder: txn: t1 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export
 lock: "\xfab"
  holder: txn: t2 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export

rollback txn=t1
----

rollback txn=t2
----

# A QueryIntent without ErrorIfMissing set (as sent during transaction
# recovery) also reports locks it finds missing. The response tells the
# caller the lock is missing either way, with the same implications for a
# later attempt to find the lock.

new-txn txn=t3
----

get txn=t3 k=d lock=Exclusive dur=Unreplicated lock-non-existing
----
get: "\xfad"=nil

query-intent txn=t3 k=d lock=Exclusive
----

print-in-memory-lock-table
----
num=1
 lock: "\xfad"
  holder: txn: t3 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export

# And the same on the write path.

new-txn txn=t4
----

get txn=t4 k=e lock=Exclusive dur=Unreplicated lock-non-existing
----
get: "\xfae"=nil

query-intent txn=t4 k=e lock=Exclusive batched-with-put=f
----

print-in-memory-lock-table
----
num=2
 lock: "\xfad"
  holder: txn: t3 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export
 lock: "\xfae"
  holder: txn: t4 epoch: 0, iso: Serializable, ts: <stripped>, info: unrepl [(str: Exclusive seq: 0)] ineligible-for-export

rollback txn=t3
----

rollback txn=t4
----
