@require '~src/components/core/index.styl'

$side-panel-width = 160px
$top-bar-height = 50px
$container-top-offset = 120px

.layout-panel
  display flex
  flex-direction column
  width 100vw
  height 100vh
  min-width 100vw
  max-width 100vw
  min-height 100vh
  max-height 100vh
  overflow hidden

.layout-panel__header
  height $top-bar-height
  min-height $top-bar-height
  background-color #000000
  color $colors--white
  z-index 1

.layout-panel__header > *
  margin 0 $spacing-small

.layout-panel__navigation-bar
  background-color $colors--white
  color $colors--title
  // Hairline rule dividing the cluster-id header from the content, kept here
  // (not on the masthead) so the separation persists even when the license
  // alert bar is absent.
  border-bottom 1px solid $colors--neutral-2

.layout-panel__navigation-bar > *
  // 20px left-aligns the cluster title with the sidebar menu text (rail 8px
  // padding + nav-row 12px padding).
  margin 0 $spacing-medium-small

.layout-panel__body
  display flex
  flex-direction row
  flex 1
  overflow hidden
  height "calc(100% - %s)" % $container-top-offset

.layout-panel__content
  width "calc(100% - %s)" % $side-panel-width
  overflow auto
  // Space above the page content (20px, ~the sidebar rail inset) so the content
  // top aligns with the sidebar's first pill. Padding (not margin) so the white
  // surface fills the inset.
  margin 0
  padding-top $spacing-medium-small
  // Left inset for the content pane; the rail is divided from it by a hairline
  // border (see .layout-panel__sidebar).
  padding-left $spacing-medium
  // Main workspace pane is the white primary surface; warm gray stays on the
  // rail.
  background-color $colors--white

.layout-panel__sidebar
  min-width $side-panel-width
  // Warm-gray rail anchored flush to the left edge and the header's bottom,
  // divided from the white content pane by a hairline right border.
  margin 0
  border-right 1px solid $colors--neutral-2
  background-color $colors--neutral-1
  // Rail padding (12px / 8px) so the pill rows sit with an even inset from the
  // rail edges.
  padding $spacing-smaller $spacing-x-small
