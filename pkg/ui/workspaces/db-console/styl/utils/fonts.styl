// 2026 brand faces — Geist / Geist Mono (SIL OFL, self-hosted woff2 only).
// partially copied from https://github.com/code42day/stylus-font-face
file($name, $ext, $path)
  $path + '/' + $name + '.' + $ext

font-face($family, $style='normal')
  @font-face
    font-family $family
    src url(file($family, 'woff2', '../fonts')) format('woff2')
    font-weight normal
    font-style $style
    text-rendering optimizeLegibility

font-face('Geist-Light')
font-face('Geist-Regular')
font-face('Geist-Medium')
font-face('Geist-Bold')
font-face('GeistMono-Light')
font-face('GeistMono-Regular')
font-face('GeistMono-Medium')
