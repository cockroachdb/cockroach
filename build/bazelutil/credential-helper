# Bazel credential helper. Bazel invokes this script as
# `credential-helper get` with a JSON request on stdin describing the
# URI it wants to fetch, and expects a JSON response on stdout
# containing the headers to attach. See
# https://github.com/EngFlow/credential-helper-spec.
#
# Two modes:
#
# 1. Automation mode. If the BAZEL_STORAGE_ACCESS_TOKEN environment
#    variable is set, return it directly as a bearer token. This is
#    used by CI, where credentials are minted out-of-band and provided
#    via the environment.
#
# 2. Local mode. Delegate to `roachdev gcp credential-helper`, which
#    serves a cached `gcloud auth application-default print-access-token`
#    via the roachdev daemon. This is used by developers on corporate
#    laptops.

set -euo pipefail

if [[ -n "${BAZEL_STORAGE_ACCESS_TOKEN:-}" ]]; then
    # Drain stdin per the credential helper spec; we don't act on the
    # request URI because the same bearer is valid for every supported
    # host.
    cat > /dev/null
    printf '{"headers":{"Authorization":["Bearer %s"]}}\n' "$BAZEL_STORAGE_ACCESS_TOKEN"
    exit 0
fi

exec roachdev gcp credential-helper "$@"
