FROM @repository@:@tag@

# --nobest tolerates Red Hat UBI repo partial-publish windows where a newer
# glibc is available without the matching glibc-minimal-langpack, which would
# otherwise make the update fail the build. See build/deploy/Dockerfile.
RUN microdnf install -y yum && \
  yum -v -y update --all --nobest && \
  microdnf clean all && \
  rm -rf /var/cache/yum

LABEL name="CockroachDB"
LABEL maintainer="Cockroach Labs"
LABEL vendor="Cockroach Labs"
LABEL summary="CockroachDB is a distributed SQL database."
LABEL description="CockroachDB is a PostgreSQL wire-compatable distributed SQL database."

ENV COCKROACH_CHANNEL=official-openshift
